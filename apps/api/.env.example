# Biến môi trường API – BrewLite A1

# PostgreSQL connection. Use a separate database for tests (for example brewlite_test).
DATABASE_URL=postgresql://brewlite:replace-local-password@localhost:5432/brewlite

# JWT secret – at least 32 characters; generate a different secret per environment.
JWT_SECRET=replace-with-random-local-secret-min-32chars

# Local HTTP: false. Production always sets Secure; set true for HTTPS outside production if needed.
COOKIE_SECURE=false

# Frontend origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# Port API (mặc định 3001)
PORT=3001

# Log level: info | warn | error | debug
LOG_LEVEL=info
