# true: giao diện demo độc lập, không dùng backend/auth thật.
NEXT_PUBLIC_DEMO_MODE=true

# Trình duyệt chỉ gọi cùng origin /api/backend/*; proxy chuyển tiếp tới NestJS.
# Đổi NEXT_PUBLIC_DEMO_MODE thành false để kết nối backend thật.
API_UPSTREAM_URL=http://localhost:3001

# Public frontend origin; also used to validate CSRF Origin headers.
FRONTEND_ORIGIN=http://localhost:3000
